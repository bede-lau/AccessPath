# AccessPath environment configuration (example template).
# Copy to .env and adjust as needed. Never commit real secrets.

# Host the local server binds to. Must remain a loopback address;
# do NOT set this to 0.0.0.0 (the app must not be exposed on the network).
ACCESSPATH_HOST=127.0.0.1

# Port for the local server. 0 means the OS selects an available port;
# this is the product security/runtime default — do not change to a fixed port.
ACCESSPATH_PORT=0

# Optional ABSOLUTE path override for the artifact root directory.
# When unset, it defaults to <home>/.accesspath, outside the repository.
# ACCESSPATH_ARTIFACT_ROOT=

# Port used by the demo aid application.
DEMO_AID_APP_PORT=4173

# Node environment.
NODE_ENV=development

# Qoder personal access token — not read, logged, or persisted in P02.
# Never commit real tokens.
# QODER_PERSONAL_ACCESS_TOKEN=
