# AccessPath environment configuration (example template).
# Copy to .env and adjust as needed. Never commit real secrets.

# Host the local server binds to. Must remain a loopback address.
ACCESSPATH_HOST=127.0.0.1

# Port for the local server. 0 lets the OS select an available port.
ACCESSPATH_PORT=0

# Optional ABSOLUTE path override for the artifact root directory.
# When unset, it defaults to <home>/.accesspath, outside the repository.
# ACCESSPATH_ARTIFACT_ROOT=

# Optional development-runner port preferences. Omit them to select the first
# available loopback ports starting at 4801 and 4173.
# ACCESSPATH_DEV_COMPANION_PORT=4801
# ACCESSPATH_DEV_DEMO_AID_APP_PORT=4173

# Node environment.
NODE_ENV=development

# Select the coding-agent backend. The direct openai adapter uses the Responses
# API and only exposes AccessPath's bounded file tools. qwen uses its SDK;
# qoder uses the Qoder SDK.
AGENT_PROVIDER=openai

# OpenAI Responses API configuration. gpt-5-mini is the efficient default
# for bounded repair tasks.
# Never commit real API keys.
# OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini

# The demo fallback waits for a genuinely inactive agent instead of cancelling
# a healthy diagnosis while Read, Glob, Grep, or agent updates are still arriving.
ACCESSPATH_DEMO_AGENT_INACTIVITY_TIMEOUT_MS=20000
ACCESSPATH_DEMO_AGENT_HARD_TIMEOUT_MS=90000

# Optional Qoder personal access token when AGENT_PROVIDER=qoder.
# QODER_PERSONAL_ACCESS_TOKEN=
