{
  "name": "accesspath",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "lint": "node scripts/lint.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test --config apps/console/playwright.config.ts",
    "test:security": "vitest run --config vitest.security.config.ts",
    "test:a11y": "playwright test --config apps/console/playwright.config.ts --grep @a11y",
    "test:agent:live": "node --env-file-if-exists=.env --import tsx scripts/qoder-live-smoke.ts",
    "test:qoder:live": "node --env-file-if-exists=.env --import tsx scripts/qoder-live-smoke.ts --provider qoder",
    "sandbox:build": "docker build --file docker/sandbox/Dockerfile --tag accesspath-sandbox:local .",
    "workspace:reset": "node --import tsx scripts/demo-reset.ts",
    "demo:reset": "node --import tsx scripts/demo-reset.ts",
    "demo:verify": "node --import tsx scripts/demo-verify.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "^20.19.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^10.8.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@vitest/runner": "^4.1.10"
  }
}
