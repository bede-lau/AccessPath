{
  "name": "@accesspath/console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/dev.mjs",
    "dev:worker": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "cd ../.. && vitest run --project console",
    "test:e2e": "cd ../.. && playwright test --config apps/console/playwright.config.ts",
    "test:a11y": "cd ../.. && playwright test --config apps/console/playwright.config.ts --grep @a11y",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@accesspath/contracts": "0.1.0",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.4",
    "vite": "^8.1.5"
  }
}
